# --- KiCad working files ---
*.lck
~*.lck
_autosave-*
*-bak
*.bak
*-backups/
fp-info-cache
*.kicad_prl

# --- Large generated Padne artifacts ---
hardware/daughterboard/**/pdn*.padne
hardware/*/padne_out_*/
hardware/*/results_*/

# --- KiCad restore backups and archives (regenerable, large) ---
hardware/**/_restore_backup_*/
hardware/*-bak.7z
hardware/*.zip

# --- Generated board 3D exports (footprint .stp models stay tracked) ---
hardware/daughterboard/daughterboard.step
hardware/motherboard/motherboard.step

# --- Local KiCad history folders (nested Git repos) ---
hardware/**/.history/

# --- PlatformIO / firmware build ---
.pio/
.vscode/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- LaTeX aux (main.pdf stays tracked as a deliverable) ---
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# --- Local tool settings ---
.claude/settings.local.json

# --- OS noise ---
.DS_Store
Thumbs.db
