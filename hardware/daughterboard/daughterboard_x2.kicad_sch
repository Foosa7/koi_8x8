		)
		(uuid "761a6808-6481-41f4-9bec-8d82d2d61d3b")
	)
	(text_box "P.U.:\n66 × XTR200 @ $1.456 → $96.096\n5 × ADS1118 @ $4 → $20.00\n17 × TMUX1108 @ $3.2 → $54.40\n66 × INA190 @ $1.7 → $112.20\n9 × DAC80508 @ $18 → $162.00\n---- motherboard ----\n1 × RP2040 @ $7 → $7.00\n1 × TPS7A @ $0.25 → $0.25\n1 × TPS5420 @ $1.32 → $1.32\n\nTotal BOM cost:\n\n$96.096+20+54.4+112.2+0.25+1.32+162+7=$453.27 (approx)\n\n\nQontrol: Cost/channel = $125\nCustom: Cost/channel ​​≈ $6.86\n\n18x cheaper\n	​\n"
		(exclude_from_sim no)
		(at 15.24 218.44 0)
		(size 73.66 43.18)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
